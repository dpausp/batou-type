from typing import Any


class ConfigUpdater:
    def __init__(
        self,
        allow_no_value: bool = ...,
        *,
        delimiters: tuple[str, ...] = ...,
        comment_prefixes: tuple[str, ...] = ...,
        inline_comment_prefixes: tuple[str, ...] | None = ...,
        strict: bool = ...,
        empty_lines_in_values: bool = ...,
        space_around_delimiters: bool = ...,
    ) -> None: ...
    def read(self, filename: Any, encoding: str | None = ...) -> ConfigUpdater: ...
    def read_file(self, f: Any, source: str | None = ...) -> ConfigUpdater: ...
    def read_string(self, string: str, source: str = ...) -> ConfigUpdater: ...
    def write(self, fp: Any, validate: bool = ...) -> None: ...
    def update_file(self, validate: bool = ...) -> ConfigUpdater: ...
    def __str__(self) -> str: ...
    def __iter__(self) -> Any: ...
    def __contains__(self, item: Any) -> bool: ...
    def __getitem__(self, item: Any) -> Any: ...
    def __setitem__(self, item: Any, value: Any) -> None: ...
    def __delitem__(self, item: Any) -> None: ...
