from collections.abc import Iterator
from typing import Any

class ANSIColors:
    FAIL: str
    ENDC: str
    BOLD: str

def error(msg: object) -> None: ...
def print_bold(msg: object) -> None: ...
def remote_sudo(host: str, password: str, cmd: list[str]) -> str: ...
def rg_account_exists(name: str, host: str, sudo_password: str) -> bool: ...

class Step:
    def verify(self, previous_result: Any) -> None: ...
    def apply(self, previous_result: Any) -> Any: ...

class Plan:
    steps: list[Step]

    def __add__(self, step: Step) -> Plan: ...
    def apply(self) -> None: ...

class StateAlreadyExists(Exception): ...
class ConfigurationError(Exception): ...

class CreateS3Account(Step):
    def __init__(self, name: str, sudo_password: str, host: str) -> None: ...
    def verify(self, _: Any) -> None: ...
    def apply(self, _: Any) -> Any: ...

class Keypair:
    def __init__(self, key_id: str, secret_key: str) -> None: ...

class CreateKeypair(Step):
    def __init__(self, rg_name: str, sudo_password: str, host: str) -> None: ...
    def verify(self, account_created: Any) -> None: ...
    def apply(self, _: Any) -> Keypair: ...

class CreateBucket(Step):
    def __init__(self, name: str) -> None: ...
    def verify(self, key: Keypair | None) -> None: ...
    def apply(self, keys: Any) -> Any: ...

class Rules:
    rules: dict[str, int]

    def __iter__(self) -> Iterator[tuple[str, int]]: ...
    def __len__(self) -> int: ...
    def add(self, prefix: str, days: int) -> None: ...

class CreateLifecyclePolicyConfiguration(Step):
    def __init__(self, bucket: str, rules: Rules) -> None: ...
    def apply(self, client: Any) -> None: ...

def ask_sudo_password() -> str: ...
def run() -> None: ...
def main() -> None: ...
